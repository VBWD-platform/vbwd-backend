# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://vbwd:vbwd@postgres:5432/vbwd
POSTGRES_USER=vbwd
POSTGRES_PASSWORD=vbwd
POSTGRES_DB=vbwd

# Redis
REDIS_URL=redis://redis:6379/0

# ===========================================
# Global API rate limits (Flask-Limiter, per-IP)
# ===========================================
# Bump for active deployments; set a value to 0 to disable that window.
# Per-route @limiter.limit overrides (e.g. /login at 5000/min) are
# independent of these defaults — see vbwd/extensions.py.
RATELIMIT_DEFAULT_DAY=100000
RATELIMIT_DEFAULT_HOUR=20000
# Storage backend (Flask-Limiter contract — passed through unchanged).
# Defaults to REDIS_URL above when unset.
# RATELIMIT_STORAGE_URL=redis://redis:6379/1
# Master kill-switch. "False" / "false" / "0" disables the global limiter.
# RATELIMIT_ENABLED=True

# JWT
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Email (optional in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=VBWD

# Payment Providers (to be configured)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# External APIs (optional)
# LOOPAI_API_URL=
# LOOPAI_API_KEY=

# ===========================================
# Test Data Configuration
# ===========================================
# When true, seeds test data into PostgreSQL before tests run
TEST_DATA_SEED=false

# When true, removes test data from database after tests complete
# When false, keeps test data in database for inspection/debugging
TEST_DATA_CLEANUP=false

# Test user credentials (used by seeding and E2E tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123@

# Test admin credentials
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=AdminPass123@

# ===========================================
# Debug / load-test introspection (S30)
# ===========================================
# Enables /api/v1/_routes and /api/v1/_seed_status. OFF by default so prod
# has zero extra attack surface. CI / dev / load-test harness opt in.
# Accepts 1 / true / yes.
VBWD_ENABLE_DEBUG_ENDPOINTS=0

# Backend URL for integration tests
API_BASE_URL=http://localhost:5000/api/v1

# ===========================================
# Internationalization
# ===========================================
# Default language for new users and fallback
DEFAULT_LANGUAGE=en
