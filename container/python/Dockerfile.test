FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY . .

# Plugin PyPI runtime deps (pure-PyPI only, e.g. PyYAML for vbwd_datavibes). The
# api image installs these at container START via its entrypoint; the test image
# has no such entrypoint, so bake the plugin deps in at BUILD time. Without them a
# plugin's top-level import (e.g. `import yaml`) fails during conftest plugin
# loading and cascades into mass collection errors across the whole suite.
# The `[ -f "$r" ]` guard matters: when no plugin ships a requirements.txt the
# glob stays literal and pip would fail on the unexpanded pattern. That is the
# normal case in per-plugin CI, which checks out only one or two plugins.
RUN for r in plugins/*/requirements.txt; do \
      [ -f "$r" ] || continue; \
      echo "[test-image] installing plugin deps from $r"; \
      pip install --no-cache-dir -r "$r"; \
    done

# Run tests
CMD ["pytest", "-q"]
